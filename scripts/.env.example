# Copiá este archivo como scripts/.env y completá el token.
# scripts/.env está en .gitignore (NO se sube al repo).

# Personal Access Token de Airtable (empieza con "pat...").
# Crear en: https://airtable.com/create/tokens
# Scopes necesarios: data.records:read, data.records:write, schema.bases:read
# Acceso: la base "El Zar de las Fragancias"
AIRTABLE_TOKEN=pat_pegar_aca

# IDs de la base/tabla (ya completados, no hace falta tocar).
AIRTABLE_BASE=appNFFIDioekqNCEV
AIRTABLE_TABLE=Perfumes

# URL pública del sitio (para el seed inicial de fotos).
SITE_URL=https://el-zar-fragancias.vercel.app
