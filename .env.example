# =============================================================
# Variables de entorno del BACKEND (funciones serverless en Vercel).
# Cargar en: Vercel -> Proyecto -> Settings -> Environment Variables (Production).
# NUNCA commitear los valores reales. Este archivo es solo de referencia.
# (El token del script de sync en Python va aparte, en scripts/.env)
# =============================================================

# --- Airtable (lectura en vivo del catálogo + escritura desde el panel) ---
AIRTABLE_TOKEN=pat_pega_tu_token_con_read_y_write
AIRTABLE_BASE=appNFFIDioekqNCEV
AIRTABLE_TABLE=Perfumes

# --- Google OAuth (login del panel /admin) ---
# Se obtienen en Google Cloud Console -> APIs y servicios -> Credenciales.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# URL de callback EXACTA registrada en Google (coincidencia exacta):
OAUTH_REDIRECT_URI=https://el-zar-fragancias.vercel.app/api/admin/auth/callback

# --- Allowlist de administradores (emails separados por coma, en minúscula) ---
ADMIN_EMAILS=tomasvioliniutn10@gmail.com

# --- Clave para firmar la sesión (HMAC). Cadena larga y aleatoria. ---
SESSION_SECRET=pega_una_cadena_larga_aleatoria
